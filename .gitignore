# ── 虚拟环境与依赖 ─────────────────────────────────
.venv/
node_modules/
package-lock.json

# ── 密钥与环境变量（绝不要提交 .env！）────────────────
.env
.env.local
!.env.example
# 部署用环境变量清单（含明文密钥，从 .env 生成，仅供粘贴到 Render）
deploy.env
# git-filter-repo 的替换表含明文旧密钥，绝不入库
replacements.txt
*.replacements.txt

# ── Python 缓存 ───────────────────────────────────
__pycache__/
*.pyc
*.pyo
.pytest_cache/
.ruff_cache/

# ── 本地数据库文件（含沙箱订单记录，不入库）────────────
*.db
*.sqlite
*.sqlite3
.pgdata/
pg.log

# ── 下载的二进制/临时文件 ───────────────────────────
*.zip
*.exe

# ── 编辑器与系统 ───────────────────────────────────
.vscode/
.idea/
.DS_Store
Thumbs.db

# ── 本地开发辅助数据（非交付物）─────────────────────
.workbuddy/

# ── AG Studio 前端运行时（npm 商业包，不入库）────────────
# 由 `python scripts/setup_ag_studio.py` 安装到 static/vendor/。
# 页面默认走 jsdelivr CDN；本地 vendor 仅在服务器挂载 /static 时生效。
static/vendor/

# ── 验证脚本的断点续跑中间状态（非交付物）──────────────
.verify_state.json

# ── 保温探针的测量输出（每次部署后重测，不是交付物）──────
# 由 `python scripts/keep_warm.py --measure` 生成。
# 真实耗时数据应该贴进 W07_KEEP_WARM.md 的验收表，而不是留在 JSON 里。
cold_start_measure.json

# ── 自检临时目录（GitHub API 响应、截图、cookie jar）──────
# 这里可能有会话 cookie / 接口响应，绝不入库。
.tmp_gh/
