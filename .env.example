# MandatePay — environment configuration
#
# Copy this file to `.env` and fill in your own credentials.
#   cp .env.example .env
#
# `.env` is gitignored. Never commit real credentials.
# `scripts/scan_secrets.py` scans the working tree AND the whole git history
# for leaked keys before every commit.

# ── PayPal sandbox ────────────────────────────────────────────────────
# Sandbox / Live toggle lives in the developer dashboard:
#   developer.paypal.com/dashboard/applications/sandbox
#   → "Apps & Credentials" tab → "REST API apps" → your app → Sandbox section
# Copy the Client ID and Secret from there.
# (Do NOT use the Live tab — this project is sandbox-only.)
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=your_sandbox_client_id
PAYPAL_CLIENT_SECRET=your_sandbox_secret

# Optional — only needed if you want PayPal to push status changes to you.
# Get it from developer.paypal.com → your app → "Webhooks" → "Add Webhook"
# (or let scripts/setup_webhook.py register it for you and fill this in).
# The main demo flow does NOT need this.
PAYPAL_WEBHOOK_ID=

# ── Database ──────────────────────────────────────────────────────────
# Leave empty to use SQLite (zero configuration, file created automatically).
# Set a PostgreSQL URL to switch backends — no business-code changes needed:
#   DATABASE_URL=postgresql://user:password@localhost:5432/mandatepay
# To run PostgreSQL locally, the quickest options are:
#   winget install -e --id PostgreSQL.PostgreSQL.16
#   docker run --name mandatepay-pg -e POSTGRES_PASSWORD=postgres -p 5432:5432 -d postgres:16
# For a free cloud PostgreSQL that never auto-deletes (used for the hosted
# demo), see the "Deployment" section of README.md:
#   DATABASE_URL=postgresql://user:password@ep-xxx.us-west-2.aws.neon.tech/mandatepay?sslmode=require
DATABASE_URL=

# ── Public tunnel (local webhook testing only) ────────────────────────
# ngrok 3.x removed anonymous sessions, so an authtoken is required
# (a free account is enough): https://dashboard.ngrok.com/get-started/your-authtoken
# Then: ngrok config add-authtoken $NGROK_AUTHTOKEN
# Not needed for the hosted deployment.
NGROK_AUTHTOKEN=

# ── Session signing key ───────────────────────────────────────────────
# Signs the session cookie used by the `/api/*` auth (see W08_API_AUTH.md).
# Strongly recommended for any public deployment:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Leave empty locally — it self-derives from PAYPAL_CLIENT_SECRET.
# Set it explicitly so that rotating your PayPal credentials later doesn't
# invalidate every session a judge is holding open.
SESSION_SECRET=

# ── LLM (any OpenAI-compatible endpoint) ──────────────────────────────
# Intent parsing speaks the standard OpenAI protocol, so any compatible
# endpoint works — change these three values and nothing else.
# Example: Z.ai (free tier, sign up with an overseas account):
#   LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
#   LLM_BASE_URL=https://api.z.ai/api/paas/v4
#   LLM_MODEL=glm-4.7-flash
LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
LLM_BASE_URL=https://api.z.ai/api/paas/v4
LLM_MODEL=glm-4.7-flash
LLM_TIMEOUT=60

# Optional: disable the GLM-family chain-of-thought (reasoning_tokens → 0).
# Passed through as extra_body {"thinking": {"type": "disabled"}} —
# ONLY set it for endpoints that accept that field, otherwise you get a 400.
# Measured: the switch does NOT change decision quality (both groups 20/20
# correct). See W05_ZAI_MIGRATION.md §5.2.
#LLM_THINKING=disabled

# Optional: backoff retries for 429/1305 overload (normal on free tiers).
#LLM_RETRY_DELAY=8
#LLM_RETRY_MAX=6

# Optional: minimum interval between two LLM calls (client-side rate limit).
# Strongly recommended on free tiers — dense retries trigger 1302 and make
# the backoff fight itself.
#LLM_MIN_INTERVAL=4

# Not required — the state machine falls back to rule-based parsing when the
# LLM is unreachable, so the demo never hard-stops. The fallback is
# *observable* (agent/llm_intent.py keeps counters), so a verification run
# can never silently claim success while the AI path was down.
#
# Legacy aliases still accepted (older docs mentioned DeepSeek):
#   DEEPSEEK_API_KEY / DEEPSEEK_BASE_URL / DEEPSEEK_MODEL
