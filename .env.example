# 复制本文件为 .env 并填入你的真实凭证
# 凭证获取：developer.paypal.com → Apps & Credentials → REST API apps（Sandbox 模式）
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=你的Sandbox应用ClientID
PAYPAL_CLIENT_SECRET=你的Sandbox应用Secret
# 可选：Webhook 签名校验需要（开发者后台 → Webhooks → 创建后拿到 Webhook ID）
PAYPAL_WEBHOOK_ID=

# ── 数据库 ────────────────────────────────────────────
# 留空则使用 SQLite（零配置，默认）。填入 PostgreSQL 连接串即切换到 PG：
#   DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mandatepay
# 本地起 PG 最省事的方式：
#   winget install -e --id PostgreSQL.PostgreSQL.16
# 或 docker run --name mandatepay-pg -e POSTGRES_PASSWORD=postgres -p 5432:5432 -d postgres:16
# 云端部署用 Neon 免费项目（不自动删库，只休眠），连接串形如：
#   DATABASE_URL=postgresql://user:password@ep-xxx.us-west-2.aws.neon.tech/mandatepay?sslmode=require
DATABASE_URL=

# ── 公网隧道（Webhook 本地联调用）────────────────────
# ngrok 3.x 取消了匿名会话，必须配 authtoken（免费账号即可）
# 获取：https://dashboard.ngrok.com/get-started/your-authtoken
# 配置后：ngrok config add-authtoken $NGROK_AUTHTOKEN
NGROK_AUTHTOKEN=

# 意图解析 LLM —— 任何 OpenAI 兼容端点均可，改这三项即可，业务代码零改动
# 示例（Z.ai，海外可注册，免费档可用）：
LLM_API_KEY=sk-xxxxxxxxxxxxxxxx
LLM_BASE_URL=https://api.z.ai/api/paas/v4
LLM_MODEL=glm-4.7-flash
LLM_TIMEOUT=60
# 可选：关闭 GLM 系列思维链（token 更省、延迟更低）。
# 通过 extra_body 透传 "thinking": {"type": "disabled"}，仅支持该字段的端点才设，否则 400。
#LLM_THINKING=disabled
# 可选：429/1305 服务过载的退避重试（免费档常态）
#LLM_RETRY_DELAY=8
#LLM_RETRY_MAX=6
# 可选：两次调用之间的最小间隔（客户端限速，免费档强烈建议保留）
#LLM_MIN_INTERVAL=4
# 不填也能跑 —— 状态机会自动降级到规则解析，demo 不受影响
# 兼容别名（旧文档写的是 DeepSeek）：DEEPSEEK_API_KEY / DEEPSEEK_BASE_URL / DEEPSEEK_MODEL
